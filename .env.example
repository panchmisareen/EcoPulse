# EcoPulse Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecopulse

# SQLite fallback (for local development without PostgreSQL)
# DATABASE_URL=sqlite:///./ecopulse.db

# ─── App Settings ────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Demo Mode ───────────────────────────────────────────────────────────────
DEMO_MODE=true
DEMO_USER_ID=1

# ─── Optional: OpenAI for AI Coach (leave blank to use rule-based engine) ────
# OPENAI_API_KEY=sk-...

# ─── Frontend: Geoapify Map Tiles ────────────────────────────────────────────
# Get your free key at https://myprojects.geoapify.com/
VITE_GEOAPIFY_KEY=your-geoapify-api-key-here

# ─── Emission Factors (kg CO2 per km) ────────────────────────────────────────
EMISSION_FACTOR_CAR=0.21
EMISSION_FACTOR_BUS=0.089
EMISSION_FACTOR_BIKE=0.0
EMISSION_FACTOR_WALK=0.0
